				<cell>10</cell>
			</row>

			<row>
				<cell>4</cell>
				<cell>32</cell>
				<cell>4s</cell>
				<cell>2</cell>
			</row>

			<row>
				<cell/>
				<cell/>
				<cell>4p, 4p, 4p</cell>
				<cell>6</cell>
			</row>

			<row>
				<cell/>
