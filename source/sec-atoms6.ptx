				<cell>6</cell>
			</row>

			<row>
				<cell>3</cell>
				<cell>18</cell>
				<cell>3s</cell>
				<cell>2</cell>
			</row>

			<row>
				<cell/>
				<cell/>
				<cell>3p, 3p, 3p</cell>
				<cell>6</cell>
			</row>

			<row>
				<cell/>
