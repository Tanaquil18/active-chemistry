			<row>
				<cell/>
				<cell/>
				<cell>?, ?, ?, ?, ?, ?, ?, ?, ? (hypothesized set of 9 orbitals)</cell>
				<cell>18?</cell>
			</row>
		</tabular>
	</table>
	<exercises>
		<title>Exercises: Electron Shells and Orbitals</title>

		<exercisegroup>
			<exercise>
				<statement>
					<p>
						Without consulting the table above, what orbitals are in the first shell,
						2nd shell, 3rd shell, and 4th shell?
					</p>
				</statement>

				<answer>
					<p>
						See <xref ref="table-shell-orbital-summary"/>.
					</p>
				</answer>
			</exercise>

			<exercise>
				<statement>
					<p>
						How many electrons are in the 3rd shell?
						How many orbitals are needed to hold that number of electrons?
						How can you get that number of orbitals by combining together different
						orbital sets?
					</p>
				</statement>

				<answer>
					<p>
						18 electrons, 9 orbitals: 1 s-orbital, 3 p-orbitals, and 5 d-orbitals.
					</p>
				</answer>
			</exercise>

			<exercise>
				<statement>
					<p>
						How many electrons can a single 4p orbital hold?
						How many electrons can the set of 4p orbitals hold?
						How many electrons can a single 5d orbital hold?
						How about the set of 5d orbitals?
					</p>
				</statement>

				<answer>
					<p>
						2, 6, 2, 10.
					</p>
				</answer>
			</exercise>

			<exercise>
				<statement>
					<p>
						Which orbital type has a shape similar to a ball?
						An hour-glass?
						A four-leaf clover?
					</p>
				</statement>

				<answer>
					<p>
						S-orbital, p-orbital, d-orbital.
					</p>
				</answer>
			</exercise>

			<exercise>
				<statement>
					<p>
						For the table above, make a 6th row and fill in the missing information.
					</p>
				</statement>

				<answer>
					<p>
						The answer key gives the following:
					</p>

					<table>
						<tabular cols="4">
							<row header="yes">
								<cell>Shell</cell>
								<cell>Number of electrons</cell>
								<cell>Orbital type</cell>
								<cell>Number of electrons in set</cell>
							</row>

							<row>
								<cell>6</cell>
								<cell>72</cell>
								<cell>6s</cell>
								<cell>2</cell>
							</row>

							<row>
								<cell/>
								<cell/>
								<cell>6p</cell>
								<cell>6</cell>
							</row>

							<row>
								<cell/>
								<cell/>
								<cell>6d</cell>
								<cell>10</cell>
							</row>

							<row>
								<cell/>
								<cell/>
								<cell>6f</cell>
								<cell>14</cell>
							</row>

							<row>
								<cell/>
								<cell/>
								<cell>??</cell>
								<cell>18?</cell>
							</row>

							<row>
								<cell/>
								<cell/>
								<cell>??</cell>
								<cell>22?</cell>
							</row>
						</tabular>
					</table>
				</answer>
			</exercise>
		</exercisegroup>
	</exercises>
</section>